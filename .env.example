# CamMind environment variables (local development)
# Copy to .env and fill in values. Never commit .env.
# Production values are documented in docs/17-deployment-ops.md.

# --- Core (Django) ---
APP_ENV=local
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=            # 50+ random characters; also signs JWTs
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=http://localhost:3200
API_BASE_URL=http://localhost:8200
DATABASE_URL=postgres://cammind:cammind@localhost:5436/cammind
REDIS_URL=redis://localhost:6381/0
CORS_ORIGINS=http://localhost:3200

# --- Object storage (SeaweedFS S3 locally, Cloudflare R2 for the hosted demo) ---
S3_ENDPOINT=http://localhost:9200
S3_BUCKET=cammind-dev
S3_ACCESS_KEY_ID=cammind
S3_SECRET_ACCESS_KEY=cammind-dev-secret

# --- Email (Mailpit locally) ---
EMAIL_URL=smtp://localhost:1027

# --- Video (go2rtc in infra/docker-compose.yml) ---
GO2RTC_URL=http://localhost:1984          # API, from the core
CAMMIND_RESTREAM_URL=rtsp://localhost:8554  # RTSP restream, from the vision worker
CAMMIND_CORE_URL=http://localhost:8200      # core API, from the vision worker

# --- Observability (optional locally) ---
SENTRY_DSN_API=
